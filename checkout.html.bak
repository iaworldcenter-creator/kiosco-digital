        {sku:'LBR-014',nombre:'Libro Metamorfosis Franz Kafka',imagen:'assets/img/Revistas/istockphoto-609437196-612x612.webp',precio:'99',precio_original:'133',descuento:'25% OFF',existencias:'12',categoria:'libros',descripcion:'Producto premium garantizado de la categoría Libros de Bolsillo. Disfruta de la mejor calidad, servicio y garantía en nuestro portal.',modelo_caja:'LBR-014',tamano_altavoz:'N/A',caracteristicas:'Garantía oficial del ecosistema, empaque de seguridad y entrega inmediata.'},
