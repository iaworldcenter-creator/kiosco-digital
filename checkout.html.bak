
<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="utf-8"/>
<title>Checkout</title>
<link href="assets/css/tailwind-built.css" rel="stylesheet"/>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col">
<main class="flex-grow container mx-auto p-4 grid grid-cols-1 lg:grid-cols-2 gap-8">
<!-- Columna izquierda – pasos -->
<section class="space-y-6" id="checkout-izquierda">
<div class="border p-4 rounded" id="paso-1-domicilio">
<h2 class="font-bold">Paso 1 – Domicilio</h2>
<form id="form-domicilio">
<input class="w-full p-2 mb-2" placeholder="Nombre completo" required="" type="text"/>
<input class="w-full p-2 mb-2" placeholder="Teléfono" required="" type="tel"/>
<input class="w-full p-2 mb-2" placeholder="Correo (opcional)" type="email"/>
<input class="w-full p-2 mb-2" placeholder="Calle y número" required="" type="text"/>
<input class="w-full p-2 mb-2" placeholder="Colonia" required="" type="text"/>
<input class="w-full p-2 mb-2" placeholder="Código postal" required="" type="text"/>
<input class="w-full p-2 mb-2" placeholder="Ciudad / Estado" required="" type="text"/>
<input class="w-full p-2 mb-2" placeholder="Puntos de referencia" type="text"/>
<button class="bg-cyan-500 text-white py-2 px-4 rounded" id="guardar-domicilio" type="button">Guardar</button>
</form>
<div class="hidden mt-2 p-2 border rounded" id="resumen-domicilio"></div>
</div>
<div class="border p-4 rounded" id="paso-2-pago">
<h2 class="font-bold">Paso 2 – Pago</h2>
<div class="space-y-2">
<button class="w-full py-2 bg-gray-800 text-white" data-metodo="tarjeta">Tarjeta</button>
<button class="w-full py-2 bg-gray-800 text-white" data-metodo="oxxo">OXXO / Conveniencia</button>
<button class="w-full py-2 bg-gray-800 text-white" data-metodo="spei">SPEI</button>
<button class="w-full py-2 bg-gray-800 text-white" data-metodo="contra">Contra entrega</button>
</div>
<div class="mt-2 hidden" id="detalle-pago"></div>
</div>
<div class="border p-4 rounded" id="paso-3-articulos">
<h2 class="font-bold">Paso 3 – Artículos</h2>
<div class="space-y-2" id="lista-articulos"></div>
</div>
</section>
<!-- Columna derecha – resumen -->
<section class="border p-4 rounded" id="checkout-derecha">
<h2 class="font-bold">Resumen de compra</h2>
<p id="tiempo-entrega">Tiempo estimado: <span>30‑45 min</span></p>
<div class="mt-4 space-y-1">
<div class="flex justify-between">Subtotal:<span id="subtotal">$0.00 MXN</span></div>
<div class="flex justify-between">Envío:<span id="envio">$0.00 MXN</span></div>
<div class="flex justify-between">Cashback:<span id="cashback">$0.00 MXN</span></div>
<div class="flex justify-between font-bold">TOTAL:<span id="total">$0.00 MXN</span></div>
</div>
<div class="mt-4 space-x-2">
<button class="bg-amber-500 text-slate-950 py-2 px-4 rounded" id="autorizar-compra">Autorizar Cargo y Completar Compra</button>
<button class="bg-gray-800 text-white py-2 px-4 rounded" id="seguir-comprando">Seguir comprando</button>
</div>
<div class="mt-4 p-2 bg-gray-800 rounded">
<p>15% de descuento por mayoreo (≥10 piezas)</p>
<p>5% de cashback (newsletter activa)</p>
<p>Garantía directa y compra protegida</p>
</div>
</section>
</main>
</body>
</html>
