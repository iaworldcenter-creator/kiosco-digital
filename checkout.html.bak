<title>Kiosco Digital | Revistas, Peri?dicos y Lectura</title>
<style>
        :root { --fondo: #020617; --azul: #3b82f6; --azul-vivo: #60a5fa; --naranja: #f59e0b; --dorado: #eab308; --texto: #f1f5f9; --crema: #0f172a; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--fondo); color: var(--texto); font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif; }
        .main-bar { position: relative; padding: 16px 24px 18px; background: #020617; color: var(--texto); border-bottom: 2px solid rgba(59, 130, 246, 0.4); box-shadow: 0 4px 16px rgba(0, 0, 0, .5); }
        .gemini-credit { margin: 0 130px 15px; text-align: center; }
        .gemini-credit .line-1 { display: block; color: rgba(245, 247, 250, .92); font-size: .98rem; font-weight: 500; }
        .gemini-credit .line-2 { display: inline-block; margin-top: 2px; color: #60a5fa; font-size: 1.04rem; font-weight: 650; text-decoration: none; }
        .gemini-credit .line-2:hover { color: #FFFFFF; text-decoration: underline; }
        .section-tag { position: absolute; top: 16px; right: 24px; padding: 6px 12px; border: 1px solid rgba(59, 130, 246, 0.4); border-radius: 999px; background: rgba(30, 41, 59, 0.8); color: rgba(255,253,249,.94); font-size: .82rem; font-weight: 600; letter-spacing: .035em; backdrop-filter: blur(7px); }
        .desktop-nav { display: flex; align-items: center; justify-content: center; gap: 7px 12px; flex-wrap: wrap; }
        .nav-group { position: relative; }
        .nav-item, .brand-name { display: inline-block; padding: 8px 9px; border-radius: 9px; color: rgba(255,253,249,.96); font-size: 1rem; font-weight: 550; text-decoration: none; transition: color .18s ease, background .18s ease, transform .18s ease; }
        .brand-name { font-size: 1.16rem; font-weight: 670; white-space: nowrap; }
        .nav-item:hover, .brand-name:hover, .nav-group:hover > .nav-item { background: rgba(255,255,255,.12); color: #FFFFFF; transform: translateY(-1px); }
        .dropdown-menu { display: none; position: absolute; z-index: 30; top: calc(100% + 8px); left: 0; min-width: 218px; padding: 7px; border: 1px solid rgba(230, 244, 250, .28); border-radius: 12px; background: rgba(18, 42, 57, .82); box-shadow: 0 14px 26px rgba(18, 59, 93, .18); backdrop-filter: blur(13px); }
        .nav-group:hover .dropdown-menu, .nav-group:focus-within .dropdown-menu { display: block; animation: menu-in .18s ease-out; }
        @keyframes menu-in { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }
        .dropdown-menu a { display: block; padding: 8px 10px; border-radius: 8px; color: rgba(245, 250, 252, .92); font-size: .91rem; font-weight: 400; line-height: 1.25; letter-spacing: .01em; text-decoration: none; transition: color .18s ease, background .18s ease; white-space: nowrap; }
        .dropdown-menu a:hover { background: rgba(255,255,255,.10); color: #7DD3FC; }
        .mobile-header, .mobile-menu { display: none; }
        .hero { padding: 25px 20px; border-bottom: 1px solid #1e293b; background: linear-gradient(110deg, #0f172a, #020617); text-align: center; }
        .hero h2 { margin: 0 0 6px; color: #3b82f6; font-size: 1.35rem; font-weight: 650; }
        .hero p { margin: 0; color: #94a3b8; font-size: 1.04rem; font-weight: 400; }
        /* Estilos obsoletos de .mascot-feature desactivados para dar paso al rediseño responsivo a pantalla completa con Tailwind CSS */
        .hero-carousel-container { position: relative; width: min(1160px, calc(100% - 32px)); height: min(57vw, 540px); min-height: 330px; margin: 28px auto 46px; overflow: hidden; border: 5px solid rgba(255,253,249,.94); border-radius: 20px; background: #D9E7EC; box-shadow: 0 14px 32px rgba(18,59,93,.16); }
        .hero-carousel-slide { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 950ms ease-in-out; }
        .hero-carousel-slide.active { opacity: 1; }
        .hero-carousel-slide img { display: block; width: 100%; height: 100%; object-fit: cover; }
        .carousel-copy { position: absolute; bottom: clamp(15px, 3.2vw, 34px); left: clamp(15px, 3.2vw, 34px); max-width: min(520px, calc(100% - 30px)); margin: 0; padding: clamp(13px, 2vw, 19px) clamp(15px, 2.5vw, 24px); border: 1px solid rgba(255,255,255,.72); border-radius: 15px; background: rgba(255, 253, 249, .56); box-shadow: 0 8px 22px rgba(18,59,93,.10); color: #173B58; font-size: clamp(1.1rem, 2vw, 1.48rem); font-weight: 590; line-height: 1.38; letter-spacing: .003em; text-align: left; text-shadow: 0 1px 0 rgba(255,255,255,.46); backdrop-filter: blur(4px); animation: copy-in .85s ease-out both; }
        @keyframes copy-in { from { opacity: 0; transform: translateY(11px); } to { opacity: 1; transform: translateY(0); } }
        .site-search { 
            display: flex; 
            align-items: center; 
            gap: 9px; 
            width: min(760px, calc(100% - 32px)); 
            margin: 18px auto 8px; 
            padding: 8px; 
            border: 2px solid rgba(59, 130, 246, 0.6); 
            border-radius: 15px; 
            background: #0b1329; 
            box-shadow: 0 0 25px rgba(59, 130, 246, 0.7); 
        }
        .site-search input { 
            flex: 1; 
            min-width: 0; 
            padding: 12px 15px; 
            border: 1px solid rgba(59, 130, 246, 0.3); 
            border-radius: 10px; 
            outline: none; 
            background: #020617; 
            color: #f1f5f9; 
            font: inherit; 
            font-size: 1rem; 
        }
        .site-search input::placeholder { color: #94a3b8; }
        .site-search input:focus { 
            border-color: #3b82f6; 
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.5); 
        }
        .site-search button { 
            padding: 12px 19px; 
            border: 0; 
            border-radius: 10px; 
            background: linear-gradient(135deg, #f59e0b, #eab308); 
            color: #020617; 
            font: inherit; 
            font-weight: 900; 
            cursor: pointer; 
            box-shadow: 0 0 12px rgba(245, 158, 11, 0.6);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .site-search button:hover { 
            background: linear-gradient(135deg, #fbbf24, #f59e0b); 
            box-shadow: 0 0 18px rgba(245, 158, 11, 0.9);
            transform: scale(1.03);
        }
        .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
        .page-content { max-width: 900px; margin: 0 auto; padding: 0 20px 46px; text-align: center; }
        .page-content p { margin: 0; color: #94a3b8; font-size: 1.08rem; line-height: 1.55; }
        .object-tech-bazar { object-fit: cover; object-position: 40% center; }
        .object-tiger-bazar { object-fit: cover; object-position: 75% 15%; }
        @media (max-width: 900px) {
            .desktop-nav { display: none; }
            .mobile-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
            .menu-toggle-btn { padding: 8px 13px; border: 1px solid rgba(255,255,255,.65); border-radius: 9px; background: rgba(255,255,255,.11); color: #FFFDF9; font-size: 1rem; font-weight: 550; cursor: pointer; }
            .mobile-menu { flex-direction: column; gap: 4px; margin-top: 14px; padding: 9px; border: 1px solid rgba(255,255,255,.16); border-radius: 13px; background: rgba(255,255,255,.09); backdrop-filter: blur(6px); }
            .mobile-menu.open { display: flex; }
            .mobile-menu .dropdown-menu { display: flex; position: static; flex-direction: column; min-width: 0; margin: 0 0 5px 9px; padding: 5px; background: rgba(18, 42, 57, .78); box-shadow: none; }
            .gemini-credit { margin: 0 0 13px; padding-right: 72px; text-align: left; }
            .section-tag { top: 15px; right: 14px; }
            .site-search { width: calc(100% - 24px); margin-top: 14px; }
            .site-search button { padding: 12px 15px; }
            /* Estilos responsivos antiguos de mascot-feature desactivados */
            .hero-carousel-container { width: calc(100% - 24px); min-height: 340px; margin-top: 20px; }
            .carousel-copy { max-width: calc(100% - 26px); bottom: 13px; left: 13px; font-size: clamp(1.04rem, 4.4vw, 1.25rem); }
        }
    
        #chatbot-window { height: 520px; max-height: 85vh; }
</style>
