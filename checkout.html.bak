            <form class="flex items-center bg-slate-950/60 rounded-full border border-cyan-500/80 shadow-[0_0_15px_rgba(6,182,212,0.6)] w-full px-2 py-1 gap-2" onsubmit="handleSearchSubmit(event);" role="search">
                <label class="sr-only" for="siteSearch">¿Qué deseas buscar hoy?</label>
                <input aria-label="Buscar productos en el catálogo" autocomplete="off" class="flex-1 bg-transparent border-0 outline-none text-white font-bold text-xs px-4 placeholder-slate-500" id="siteSearch" name="q" placeholder="¿Qué producto, pieza o antojo buscas hoy? Escribe aquí..." type="text"/>
                <button aria-label="Buscar" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black px-6 py-1.5 rounded-full text-xs uppercase tracking-wider transition active:scale-95 shrink-0" type="submit">BUSCAR</button>
            </form>
        </div>

        <!-- Lado Derecho: Botón unificado del Carrito de Compras -->
        <div class="shrink-0 flex items-center justify-end">
            <button onclick="toggleCartDrawer()" class="flex items-center gap-3 bg-transparent border-0 hover:text-cyan-400 text-white font-black transition active:scale-95 group cursor-pointer" aria-label="Ver carrito">
                <div class="relative">
                    <i class="fa-solid fa-cart-shopping text-2xl text-slate-100 group-hover:text-cyan-400 transition"></i>
                    <span class="absolute -top-2.5 -right-2.5 bg-cyan-500 text-white text-[10px] font-black rounded-full px-1.5 py-0.2 min-w-[18px] text-center shadow-lg shadow-cyan-500/20" id="cart-badge-count">0</span>
                </div>
                <span class="text-xs font-black tracking-wide uppercase text-slate-100 group-hover:text-cyan-400 transition hidden sm:inline">Mi Carrito</span>
            </button>
        </div>
    </div>
