<main class="flex-grow py-8 px-4 md:px-12 bg-slate-950 text-slate-100">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Lado Izquierdo: Formularios Pasos 1 y 2 (Colapsables) -->
        <div class="lg:col-span-7 flex flex-col gap-6">
            
            <!-- SECCIÓN 1: Domicilio de Entrega -->
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-md transition-all duration-300" id="step-delivery-card">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-base font-black text-white flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-cyan-500 text-slate-950 flex items-center justify-center text-xs font-black">1</span>
                        Domicilio de Entrega (Registro Obligatorio)
                    </h2>
                    <button onclick="editDelivery()" id="delivery-edit-btn" class="hidden text-xs text-cyan-400 hover:underline font-bold focus:outline-none">Editar</button>
                </div>
                
                <!-- Formulario -->
                <form id="delivery-form" onsubmit="saveDelivery(event)" class="flex flex-col gap-3">
                    <div>
                        <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Nombre Completo</label>
                        <input type="text" id="devName" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Teléfono (10 dígitos)</label>
                            <input type="tel" id="devPhone" required pattern="[0-9]{10}" placeholder="Ej: 3337271440" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Correo Electrónico</label>
                            <input type="email" id="devEmail" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Calle y Número</label>
                        <input type="text" id="devStreet" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="col-span-2">
                            <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Colonia</label>
                            <input type="text" id="devColonia" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Código Postal</label>
                            <input type="text" id="devCp" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Ciudad / Estado</label>
                        <input type="text" id="devCity" required value="Guadalajara, Jalisco" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
                    </div>
                    <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black py-2.5 rounded-xl text-xs uppercase tracking-wider transition mt-2 cursor-pointer">Guardar Datos de Entrega</button>
                </form>
                
                <!-- Resumen Colapsado -->
                <div id="delivery-summary" class="hidden flex flex-col gap-1.5 text-xs text-slate-300">
                    <div class="font-bold text-white" id="sum-name"></div>
                    <div id="sum-phone-email"></div>
                    <div id="sum-address"></div>
                </div>
            </div>

            <!-- SECCIÓN 2: Método de Pago -->
            <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-md transition-all duration-300 opacity-60" id="step-payment-card">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-base font-black text-white flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs font-black" id="step-payment-badge">2</span>
                        Método de Pago
                    </h2>
                    <button onclick="editPayment()" id="payment-edit-btn" class="hidden text-xs text-cyan-400 hover:underline font-bold focus:outline-none">Editar</button>
                </div>
                
                <!-- Selectores de pago -->
                <div id="payment-options" class="hidden flex-col gap-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <button onclick="selectPaymentMethod('Efectivo')" class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center gap-2 hover:border-cyan-500 transition cursor-pointer active:scale-95">
                            <i class="fa-solid fa-money-bill-1 text-emerald-400 text-2xl"></i>
                            <span class="text-xs font-bold text-white">Efectivo / OXXO / Depósito</span>
                        </button>
                        <button onclick="toggleCardForm()" class="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center gap-2 hover:border-cyan-500 transition cursor-pointer active:scale-95">
                            <i class="fa-solid fa-credit-card text-cyan-400 text-2xl"></i>
                            <span class="text-xs font-bold text-white">Tarjeta de Crédito / Débito</span>
                        </button>
                    </div>
                    
                    <!-- Tarjeta Formulario -->
                    <form id="card-payment-form" onsubmit="saveCardDetails(event)" class="hidden border-t border-slate-800 pt-4 flex flex-col gap-3">
                        <div>
                            <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Nombre en la Tarjeta</label>
                            <input type="text" id="cardName" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Número de Tarjeta</label>
                            <input type="text" id="cardNum" placeholder="4152 ...." required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">Vencimiento</label>
                                <input type="text" id="cardExp" placeholder="MM/AA" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-wider font-bold text-slate-400 mb-1">CVV</label>
                                <input type="text" id="cardCvv2" placeholder="123" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400">
                            </div>
                        </div>
                        <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black py-2.5 rounded-xl text-xs uppercase tracking-wider transition cursor-pointer">Registrar Tarjeta</button>
                    </form>
                </div>
                
                <!-- Resumen Pago -->
                <div id="payment-summary" class="hidden text-xs text-emerald-400 font-bold"></div>
            </div>
        </div>
        
        <!-- Lado Derecho: Carrito y Resumen de Totales (Pasos 3) -->
        <div class="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-md flex flex-col gap-5 text-slate-100">
            <h2 class="text-base font-black text-white flex items-center gap-2 border-b border-slate-800 pb-3">
                <span class="w-6 h-6 rounded-full bg-cyan-500 text-slate-950 flex items-center justify-center text-xs font-black">3</span>
                Revisión e Importes
            </h2>
            
            <!-- Lista de productos -->
            <div class="flex flex-col gap-3 overflow-y-auto max-h-[30vh] pr-1" id="checkout-cart-items">
                <!-- Dinámico -->
            </div>
            
            <!-- Totales -->
            <div class="border-t border-slate-800 pt-4 flex flex-col gap-2.5 text-xs text-slate-300">
                <div class="flex justify-between">
                    <span>Subtotal de Artículos:</span>
                    <span class="font-bold text-white" id="co-subtotal">$0.00 MXN</span>
                </div>
                <div class="flex justify-between hidden" id="co-wholesale-row">
                    <span class="text-amber-500 font-bold">Descuento de Mayoreo (15%):</span>
                    <span class="text-amber-500 font-bold" id="co-wholesale-disc">-$0.00 MXN</span>
                </div>
                <div class="flex justify-between">
                    <span>Gastos de Envío Local:</span>
                    <span class="font-bold text-white" id="co-shipping">$0.00 MXN</span>
                </div>
                <div class="flex flex-col gap-1 border-t border-slate-850 pt-2.5 mt-1" id="co-cashback-row">
                    <!-- Dinámico -->
                </div>
                <div class="flex justify-between items-center border-t border-slate-800 pt-3 mt-1">
                    <span class="text-sm font-black text-white uppercase tracking-wider">Total a Pagar:</span>
                    <span class="text-xl font-black text-cyan-400" id="co-total">$0.00 MXN</span>
                </div>
            </div>
            
            <!-- Botones de Acción -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
                <button onclick="window.location.href='index.html'" class="w-full bg-slate-800 hover:bg-slate-700 text-white font-bold py-3.5 rounded-xl text-xs transition cursor-pointer flex items-center justify-center gap-1.5 active:scale-95">
                    <i class="fa-solid fa-arrow-left"></i> Seguir comprando
                </button>
                <button onclick="finalizePurchase()" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-black py-3.5 rounded-xl text-xs uppercase tracking-wider transition cursor-pointer flex items-center justify-center gap-1.5 active:scale-95 shadow-md shadow-amber-500/10">
                    Confirmar Compra <i class="fa-solid fa-circle-check"></i>
                </button>
            </div>
        </div>
    </div>
</main>

